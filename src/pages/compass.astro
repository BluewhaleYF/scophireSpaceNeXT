---
/**
 * 站点罗盘页：常用站点按分组陈列（本地数据源，构建期取得后交给客户端岛渲染；
 * 搜索过滤 / 分组锚点滚动 / stagger 入场均为交互态）。
 */
import CompassSection from "@components/organisms/CompassSection.svelte";
import I18nKey from "@i18n/i18nKey";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { resolveAsset } from "@utils/asset-utils";
import { resolveI18nText } from "@utils/i18n-utils";
import { compassConfig } from "@/config/compassConfig";
import { compassData } from "../data/compass";

if (!compassConfig.enable) {
	return Astro.redirect("/404/");
}

const pageTitle = resolveI18nText(compassConfig.title, I18nKey.compass);
const pageDescription = resolveI18nText(
	compassConfig.description,
	I18nKey.compassBanner,
);

// 构建期解析站点图标：src/assets 相对路径输出带哈希的静态地址；
// /public 绝对路径与远程 URL 原样返回（与友链 / 游戏页同一套规则）。
const shelves = await Promise.all(
	compassData.map(async (shelf) => ({
		...shelf,
		entries: await Promise.all(
			shelf.entries.map(async (entry) => ({
				...entry,
				image: entry.image ? await resolveAsset(entry.image) : entry.image,
			})),
		),
	})),
);
---

<MainGridLayout title={pageTitle} description={pageDescription} page="compass">
    <CompassSection shelves={shelves} title={pageTitle} subtitle={pageDescription} client:visible></CompassSection>
</MainGridLayout>
