---
import Avatar from "@components/atoms/display/Avatar.svelte";
import Card from "@components/atoms/display/Card.svelte";
import Icon from "@components/atoms/display/Icon.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { resolveResponsiveAvatar } from "@utils/avatar-image";
import { aboutConfig, profileConfig } from "@/config";
import type { AboutIntroFactKey } from "@/types/aboutConfig";

const intro = aboutConfig.intro;
const facts = intro?.enable ? (intro.facts ?? []) : [];
const show = facts.length > 0;

const avatar = show
	? await resolveResponsiveAvatar(profileConfig.avatar, {
			widths: [132, 168, 230, 460],
			preferredWidth: 230,
		})
	: null;

const factMeta: Record<AboutIntroFactKey, { label: I18nKey; icon: string }> = {
	occupation: {
		label: I18nKey.aboutOccupation,
		icon: "material-symbols:school-outline-rounded",
	},
	birthday: {
		label: I18nKey.aboutBirthday,
		icon: "material-symbols:cake-outline-rounded",
	},
	location: {
		label: I18nKey.aboutLocation,
		icon: "material-symbols:location-on-outline-rounded",
	},
	timezone: {
		label: I18nKey.aboutTimezone,
		icon: "material-symbols:schedule-outline-rounded",
	},
};
---

{
	show && avatar && (
		<section class="about-intro">
			<Card
				color="var(--card-bg)"
				radius="l"
			>
				<div class="about-intro__layout">
					<div class="about-intro__portrait">
						<Avatar
							src={avatar.src}
							srcset={avatar.srcset}
							sizes="(min-width: 1024px) 230px, (min-width: 640px) 168px, 132px"
							width={avatar.width}
							height={avatar.height}
							alt=""
							size={144}
							shape="rounded"
							class="!absolute !inset-0 !h-full !w-full"
						/>
					</div>
					<div class="about-intro__body">
					<p class="about-intro__name">{profileConfig.name}</p>
					<span
						class="about-intro__accent"
						aria-hidden="true"
					/>
					{intro?.tagline && (
						<p class="about-intro__tagline">{intro.tagline}</p>
					)}
					<ul class="about-intro__facts">
						{facts.map((fact) => {
							const meta = factMeta[fact.key];
							return (
								<li class="about-intro__fact">
									<span
										class="about-intro__fact-icon"
										aria-hidden="true"
									>
										<Icon
											icon={meta.icon}
											width={18}
											height={18}
										/>
									</span>
									<span class="about-intro__fact-text">
										<span class="about-intro__fact-label">
											{i18n(meta.label)}
										</span>
										<span class="about-intro__fact-value">
											{fact.value}
										</span>
									</span>
								</li>
							);
						})}
					</ul>
					</div>
				</div>
			</Card>
		</section>
	)
}

<style lang="stylus">
.about-intro
	margin-bottom: var(--m3e-space-4)

	&__layout
		display: grid
		grid-template-columns: 9.45rem minmax(0, 1fr)
		align-items: stretch
		gap: var(--m3e-space-3)
		padding: var(--m3e-space-3)
		@media (min-width: 640px)
			grid-template-columns: 10.5rem minmax(0, 1fr)
			gap: var(--m3e-space-6)
			padding: var(--m3e-space-6)
		@media (min-width: 1024px)
			grid-template-columns: calc((var(--sidebar-width) - var(--m3e-space-6)) * 0.9) minmax(0, 1fr)

	&__portrait
		position: relative
		align-self: start
		aspect-ratio: 7 / 10
		min-width: 0
		min-height: 0
		overflow: hidden
		border-radius: var(--shape-corner-m)
		@media (min-width: 1024px)
			aspect-ratio: 1

	&__body
		display: flex
		flex-direction: column
		height: 100%
		min-width: 0

	&__name
		margin: 0
		font: var(--m3e-type-headline-small)
		font-weight: 700
		color: var(--on-surface)
		@media (min-width: 1024px)
			font: var(--m3e-type-headline-medium)
			font-weight: 700

	&__accent
		display: block
		width: 2rem
		height: var(--m3e-space-1)
		margin: var(--m3e-space-2) 0
		border-radius: var(--shape-corner-full)
		background: var(--primary)

	&__tagline
		margin: 0 0 var(--m3e-space-2)
		font: var(--m3e-type-body-medium)
		color: var(--on-surface-variant)
		@media (min-width: 1024px)
			font: var(--m3e-type-body-large)

	&__facts
		display: grid
		grid-template-columns: repeat(2, minmax(0, 1fr))
		gap: var(--m3e-space-2)
		margin: var(--m3e-space-2) 0 0
		padding: 0
		list-style: none
		@media (min-width: 640px)
			gap: var(--m3e-space-4)

	&__fact
		display: flex
		align-items: center
		gap: var(--m3e-space-2)
		min-width: 0
		padding: var(--m3e-space-2) var(--m3e-space-1)
		border-radius: var(--shape-corner-m)
		background: var(--surface-container)
		@media (min-width: 640px)
			padding: var(--m3e-space-2) var(--m3e-space-3)

	&__fact-icon
		display: inline-flex
		align-items: center
		justify-content: center
		flex-shrink: 0
		width: 1.75rem
		height: 1.75rem
		border-radius: var(--shape-corner-s)
		background: var(--primary-container)
		color: var(--on-primary-container)

	&__fact-text
		display: block
		min-width: 0

	&__fact-label
		display: block
		font: var(--m3e-type-label-small)
		color: var(--on-surface-variant)
		@media (min-width: 640px)
			font: var(--m3e-type-label-medium)

	&__fact-value
		display: block
		font: var(--m3e-type-body-small)
		font-weight: 500
		color: var(--on-surface)
		overflow-wrap: break-word
		@media (min-width: 640px)
			font: var(--m3e-type-body-large)
			font-weight: 500

	@media (max-width: 639.98px)
		&__accent
			margin-bottom: var(--m3e-space-1)

		&__tagline
			margin-bottom: var(--m3e-space-1)

		&__facts
			margin-top: var(--m3e-space-1)

		&__fact
			display: grid
			grid-template-columns: auto minmax(0, 1fr)
			grid-template-areas: "icon label" "value value"
			column-gap: var(--m3e-space-2)
			row-gap: 0

		&__fact-icon
			grid-area: icon
			align-self: center

		&__fact-text
			display: contents

		&__fact-label
			grid-area: label
			align-self: center

		&__fact-value
			grid-area: value
</style>
